{
  "name": "cockpit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/migrate.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "npx --yes auth@1.7.14 generate --config scripts/better-auth.config.ts --output src/server/db/schema/auth.ts -y",
    "dev:test": "node scripts/dev-test.mjs",
    "test": "npm run test:unit && npm run test:db:reset && npm run test:integration && npm run test:db:reset && npm run test:e2e",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "test:db:reset": "node scripts/test-db.mjs",
    "test:unit": "node --import tsx --test \"tests/unit/*.test.ts\"",
    "test:integration": "node --conditions=react-server --import tsx --test \"tests/integration/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@better-auth/cimd": "^1.7.14",
    "@better-auth/mcp": "^1.7.14",
    "@better-auth/oauth-provider": "^1.7.14",
    "@better-auth/passkey": "^1.7.14",
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-pgvector": "^0.0.14",
    "@modelcontextprotocol/server": "^2.4.0",
    "@sentry/nextjs": "^11.10.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vercel/blob": "^2.8.2",
    "ai": "^7.0.155",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.62.0",
    "mcp-handler": "^2.3.0",
    "motion": "^14.7.1",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-qr-code": "^2.2.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.9.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
