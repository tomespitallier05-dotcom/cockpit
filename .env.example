# Copy to .env.local for local development. Never commit real values.

# Public URL of the app (used for auth callbacks and passkeys: the passkey
# "relying party" is this URL's hostname).
BETTER_AUTH_URL=http://localhost:3000

# Random secret, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# The only email allowed to create the owner account. Required in production.
OWNER_EMAIL=

# Postgres connection string. Leave empty locally to use the embedded PGlite
# database in ./.pglite. On Supabase, use the transaction pooler URL (port 6543).
DATABASE_URL=

# Optional: connection used by `npm run db:migrate` only. On Supabase, the
# session pooler URL (port 5432). Falls back to DATABASE_URL.
DIRECT_DATABASE_URL=

# Optional: where PGlite stores its data when DATABASE_URL is empty.
# PGLITE_DIR=.pglite
