# Copy to .env.local for local development. Never commit real values.

# Public URL of the app (used for auth callbacks and passkeys: the passkey
# "relying party" is this URL's hostname).
BETTER_AUTH_URL=http://localhost:3000

# Random secret, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# The only email allowed to create the owner account. Required in production.
OWNER_EMAIL=

# Postgres connection string. Leave empty locally to use the embedded PGlite
# database in ./.pglite. On Supabase, use the transaction pooler URL (port 6543).
DATABASE_URL=

# Optional: connection used by `npm run db:migrate` only. On Supabase, the
# session pooler URL (port 5432). Falls back to DATABASE_URL.
DIRECT_DATABASE_URL=

# File storage. Leave empty locally: files go to ./.uploads. In production, connect
# a *private* Vercel Blob store to the project from the dashboard: Vercel injects
# BLOB_STORE_ID (auth uses the deployment's OIDC identity, no secret to copy).
# A BLOB_READ_WRITE_TOKEN also works.
# BLOB_STORE_ID=

# Optional: where PGlite stores its data when DATABASE_URL is empty.
# PGLITE_DIR=.pglite

# --- Phase 2: AI -----------------------------------------------------------
# Claude (analysis, assistant, reviews, brief). Without it, AI features stay off.
ANTHROPIC_API_KEY=
# Optional: model (default claude-opus-5-5) and monthly spend cap in USD (default 25).
# AI_MODEL=claude-opus-5-5
# AI_MONTHLY_BUDGET_USD=25
# Embeddings (semantic search) and transcription go through Vercel AI Gateway:
# automatic on Vercel (OIDC). Locally, set a gateway key, or AI_MOCK=1 to test
# the whole pipeline with deterministic stand-ins (npm run dev:test does this).
# AI_GATEWAY_API_KEY=
# AI_MOCK=1

# --- Phase 3: notifications and daily job ------------------------------------
# Web Push. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# REQUIRED for the daily job (/api/cron/daily): without it the endpoint answers 500 and
# does nothing; a wrong or missing Bearer token is a 401. Vercel sends it automatically
# once the variable is set on the project. Any long random string.
CRON_SECRET=

# --- Reliability -----------------------------------------------------------
# Sentry: error reports and the alert when the daily job fails or does not run.
# Empty = Sentry disabled. The DSN is public by design.
NEXT_PUBLIC_SENTRY_DSN=
# Optional, to upload source maps at build time (set all three, or none):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Tests only (npm run test:db:up). Must point to a LOCAL throwaway database: the tests
# refuse any other host. Default: postgres://cockpit:cockpit@127.0.0.1:54329/cockpit_test
# TEST_DATABASE_URL=

# --- Phase 4: integrations -------------------------------------------------
# Google Calendar + Drive (read-only, linked from Settings; never used to sign in).
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord bot over HTTP interactions. Interactions URL: <BETTER_AUTH_URL>/api/discord/interactions
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Your Discord user id: only you can use the bot.
DISCORD_OWNER_ID=
# Inbound email (Postmark inbound webhook). The secret is sent as the Basic auth password:
#   https://inbound:<secret>@<your-domain>/api/inbound/email   (a ?token= in the URL is refused)
INBOUND_EMAIL_SECRET=

# Extra origins allowed to call the auth API (comma-separated, https://...). Vercel preview
# URLs are added automatically.
TRUSTED_ORIGINS=

# 1 = Content-Security-Policy only reported in the browser console, never enforced.
CSP_REPORT_ONLY=
